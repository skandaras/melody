# Copy to .env for local development. Docker sets its own values in compose.
#
# There is deliberately no OPENROUTER_API_KEY here. The key is entered in
# Admin → OpenRouter and stored encrypted in the database, so rotating it is a
# form field rather than a redeploy, and it never sits in a shell profile or a
# compose file. Same for model choice, budget caps and transcription
# thresholds — all admin settings, not environment variables.

# Where the SQLite DB, recordings, skills and exports live.
DATA_DIR=./data

# Public URL. Required behind a reverse proxy — without it SvelteKit's CSRF
# check rejects multipart uploads, which is how audio recordings arrive.
ORIGIN=http://localhost:5173

# adapter-node defaults to 512K, far below a few minutes of recorded audio.
BODY_SIZE_LIMIT=64M

# Cosmetic badge in the UI shell; also reported by /healthz.
MELODY_ENV=dev

# authelia = trust forwarded identity headers from TRUSTED_PROXY_IPS.
# dev      = local bypass, grants DEV_USER admin. Never set this in production.
AUTH_MODE=dev
DEV_USER=dev

# Comma-separated IPs / IPv4 CIDRs allowed to supply Remote-User headers.
# Defaults to loopback only, which is fail-closed behind a real proxy.
TRUSTED_PROXY_IPS=127.0.0.1,::1

# Authelia group granting access to /admin.
ADMIN_GROUP=melody-admins

# 64 hex chars. Master key for AES-256-GCM encryption of provider API keys at
# rest. Generated into DATA_DIR/melody.key if unset — losing it means
# re-entering provider keys, nothing worse.
# SECRET_KEY=
